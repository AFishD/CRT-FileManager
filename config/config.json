{
  // ============================================
  // CRT 显示器效果配置
  // 修改此文件后重启容器即可生效 (docker-compose restart)
  // ============================================

  "crt_effects": {
    // 总开关 - 设为 false 可完全关闭所有CRT效果
    "enabled": true,

    // 桶形畸变 (Barrel Distortion)
    // 模拟CRT曲面玻璃导致的图像边缘变形
    "distortion": {
      // 畸变强度 (0-0.2)，越大边缘变形越明显
      "strength": 0.05,
      // 中心缩放比例 (1.0-1.1)，补偿畸变导致的边缘裁切
      "zoom": 1.02
    },

    // 扫描线 (Scanlines)
    // CRT逐行扫描产生的水平暗条纹
    "scanlines": {
      // 扫描线不透明度 (0-1)，越大条纹越明显
      "opacity": 0.3,
      // 扫描线间距 (px)，通常 2-4
      "spacing": 2
    },

    // 荫罩 / 荧光粉点阵 (Shadow Mask)
    // 模拟彩色CRT的RGB荧光粉排布
    "shadow_mask": {
      // 是否启用荫罩效果
      "enabled": true,
      // 荫罩不透明度 (0-0.2)，越大RGB条纹越明显
      "opacity": 0.06
    },

    // 暗角效果 (Vignetting)
    // CRT电子束在边缘衰减导致的中心亮、边缘暗
    "vignette": {
      // 暗角强度 (0-1)，越大边缘越暗
      "strength": 0.4
    },

    // 荧光粉余晖 (Phosphor Glow)
    // 模拟CRT荧光粉发光的柔和光晕
    "glow": {
      // 光晕半径 (CSS单位)
      "strength": "5px",
      // 光晕颜色 (CSS颜色值)
      "color": "rgba(255, 255, 255, 0.8)"
    },

    // 屏幕闪烁 (Flicker)
    // 模拟CRT电源不稳定导致的亮度微小波动
    "flicker": {
      // 是否启用闪烁效果
      "enabled": true,
      // 闪烁强度 (0-0.1)，越大闪烁越明显
      "intensity": 0.1
    },

    // 模糊 (Blur)
    // 模拟CRT荧光粉发光的轻微扩散
    "blur": {
      // 模糊半径 (CSS单位)
      "strength": "0.3px"
    },

    // 电源指示灯 (Power LED)
    // 屏幕右下角的绿色指示灯
    "power_led": {
      // 是否显示电源指示灯
      "enabled": true
    }
  },

  // ============================================
  // 颜色配置
  // ============================================

  "colors": {
    // 默认文字颜色
    "text_default": "#FFFFFF",
    // 已完成项目的文字颜色（划线状态）
    "text_completed": "#555555",
    // 次要文字颜色（如表格计数、页码等）
    "text_dim": "#888888",
    // 高亮行的背景颜色
    "highlight_bg": "rgba(255, 255, 255, 0.08)",
    // 强调色（暂留用）
    "accent": "#00ff41"
  }
}
